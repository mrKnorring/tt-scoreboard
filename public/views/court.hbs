<header class='flex w-full mt-4 justify-center items-center relative'>
	<h1 class='text-5xl font-bold'>{{title}}</h1>
</header>
<main class='max-w-screen-xl mx-auto mt-12'>

	<table class='w-full border-separate border-spacing-y-4 font-bold table-auto'>

		{{#each matches}}
			<tr>
				<td>
					<h3 class='text-2xl text-right'>{{homeTeam.name}}</h3>
				</td>
				<td class='w-24 pl-8 pr-4'>
					<img src='{{homeTeam.image}}' class='max-w-24' />
				</td>
				<td class='relative max-w-24 min-w-40'>
					<div class='text-center flex items-center justify-center flex-col max-w-30'>
						<div class='flex flex-row gap-2 items-center justify-center'>
							<div class='score'>{{homeTeam.score}}</div>
							<div class='score'>{{awayTeam.score}}</div>
						</div>
					</div>
					<div
						class='absolute w-full text-center -bottom-5 left-1/2 transform -translate-x-1/2 -translate-y-1/2'
					>
						{{table}}
					</div>
				</td>
				<td class='w-24 pr-8 pl-4'>
					<img src='{{awayTeam.image}}' class='max-w-24' />
				</td>
				<td>
					<h3 class='text-2xl'>{{awayTeam.name}}</h3>
				</td>
			</tr>
		{{/each}}
	</table>
</main>
<footer class='absolute bottom-2 right-8 text-sm' x-data='state'>
	Uppdaterades senast:
	<span x-text='time'></span>
</footer>
<script>
	setTimeout(() => location.reload(), 120000); const getCurrentTime = () => { const now = new Date(); const hours =
	String(now.getHours()).padStart(2, '0'); const minutes = String(now.getMinutes()).padStart(2, '0'); const seconds =
	String(now.getSeconds()).padStart(2, '0'); return `${hours}:${minutes}`; } document.addEventListener('alpine:init',
	() => { Alpine.data('state', () => ({ time: getCurrentTime(), })) })
</script>